{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tideline:schema:tideline-envelope/1",
  "title": "Tideline run envelope",
  "description": "The signed manifest a sensor sends with POST /v1/runs. The signature (ES256) covers these exact bytes and travels in the Tideline-Signature header. Each part's sha256 and bytes are taken over the file as the tool wrote it, before gzip, and match the tool's own SHA-256 manifest. Written by run-recon first; to move to the tideline-schemas repository.",
  "x-tideline-schema": "tideline-envelope/1",
  "x-minor": 0,
  "type": "object",
  "properties": {
    "schema": {
      "const": "tideline-envelope/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sensor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "engagement": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "job_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "started": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "finished": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "profile": {
      "type": "object"
    },
    "tool_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z-]{0,31}$"
          },
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*/[0-9]+$"
          },
          "media": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9.+-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "n",
          "kind",
          "name",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "kind": {
              "const": "artifact"
            }
          }
        },
        "then": {
          "required": [
            "media"
          ]
        },
        "else": {
          "required": [
            "schema",
            "records"
          ]
        }
      }
    }
  },
  "required": [
    "schema",
    "run_id",
    "tool",
    "tool_version",
    "sensor",
    "engagement",
    "job_id",
    "started",
    "finished",
    "exit_code",
    "profile",
    "tool_manifest_sha256",
    "parts"
  ],
  "additionalProperties": false
}
